@model IEnumerable<ASP.NET_FinalProject.Models.ResourcePack>

@{
    ViewData["Title"] = "Resource Packs Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>List of Resource Packs</h2>
    <a asp-action="Create" class="btn btn-success">Add New Resource Pack</a>
</div>

<div class="row">
    @foreach (var item in Model) {
        <div class="col-md-4 mb-4">
            <partial name="_ResourcePackCard" model="item" />
        </div>
    }
</div>