@model ASP.NET_FinalProject.Models.ResourcePack

@{
    ViewData["Title"] = "Add Resource Pack";
}

<h2>Adding New Resource Pack</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label">Title</label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Author" class="control-label">Author</label>
                <input asp-for="Author" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label">Image URL (Optional)</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="DownloadUrl" class="control-label">Download Link</label>
                <input asp-for="DownloadUrl" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResourceCategoryId" class="control-label">Category</label>
                <select asp-for="ResourceCategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                    <option value="">-- Select Category --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResourceFeatureId" class="control-label">Екстра (Feature)</label>
                <select asp-for="ResourceFeatureId" class="form-control" asp-items="@(new SelectList(ViewBag.Features, "Id", "Name"))">
                    <option value="">-- Select Feature --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResourceResolutionId" class="control-label">Resolution</label>
                <select asp-for="ResourceResolutionId" class="form-control" asp-items="@(new SelectList(ViewBag.Resolutions, "Id", "Name"))">
                    <option value="">-- Select Resolution --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GameVersionId" class="control-label">Game Version</label>
                <select asp-for="GameVersionId" class="form-control" asp-items="@(new SelectList(ViewBag.GameVersions, "Id", "VersionNumber"))">
                    <option value="">-- Select Version --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>