@model ASP.NET_FinalProject.Models.ResourcePack

@{
    ViewData["Title"] = "Delete Resource Pack";
}

<h2 class="text-danger">Are you sure you want to delete this resource pack?</h2>

<div class="card bg-light p-4 mt-3">
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Author:</dt>
        <dd class="col-sm-10">@Model.Author</dd>
        <dt class="col-sm-2">Description:</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete permanently" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>