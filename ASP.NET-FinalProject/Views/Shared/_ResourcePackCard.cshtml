@model ASP.NET_FinalProject.Models.ResourcePack

<div class="card h-100 shadow-sm">
    @if(!string.IsNullOrEmpty(Model.ImageUrl)){
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height: 200px; object-fit: cover;">
    }
    <div class="card-body">
        <h5 class="card-title text-white">@Model.Title</h5>
        <h6 class="card-subtitle mb-2 text-muted">By @Model.Author</h6>
        <p class="card-text text-truncate text-secondary">@Model.Description</p>
    </div>
    <div class="card-footer bg-light">
        <div class="mb-2">
            <span class="badge bg-primary text-light">@Model.ResourceCategory.Name</span>
            <span class="badge bg-success text-light">@Model.ResourceFeature.Name</span>
            <span class="badge bg-warning text-dark">@Model.ResourceResolution.Name</span>
            <span class="badge bg-secondary text-light">@Model.GameVersion.VersionNumber</span>
        </div>
        <div class="d-flex justify-content-end gap-1">
            <a asp-controller="ResourcePacks" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Details</a>
            <a asp-controller="ResourcePacks" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning text-dark">Edit</a>
            <a asp-controller="ResourcePacks" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">Delete</a>
        </div>
    </div>
</div>