@model IEnumerable<ASP.NET_FinalProject.Models.ModProject>

@{
    ViewData["Title"] = "Mods Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>List of Mods</h2>
    <a asp-action="Create" class="btn btn-success">Add New Mod</a>
</div>

<div class="row">
    @foreach (var item in Model) {
        <div class="col-md-4 mb-4">
            <partial name="_ModCard" model="item" />
        </div>
    }
</div>