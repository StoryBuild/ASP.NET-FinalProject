@model ASP.NET_FinalProject.Models.DataPack

@{
    ViewData["Title"] = Model.Title;
}

<div class="row mt-4">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Title">
        }
    </div>
    <div class="col-md-8">
        <h1 class="display-5 fw-bold">@Model.Title</h1>
        <h4 class="text-muted">Автор: @Model.Author</h4>

        <p class="lead mt-3">@Model.Description</p>
        <hr />
        <div class="mb-3 d-flex flex-wrap gap-2">
            <span class="badge bg-primary">Category: @Model.DataPackCategory.Name</span>
            <span class="badge bg-secondary">Version: @Model.GameVersion.VersionNumber</span>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a href="@Model.DownloadUrl" target="_blank" class="btn btn-lg btn-danger"><i class="bi bi-download"></i> Download</a>
            <a asp-action="Index" class="btn btn-lg btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>